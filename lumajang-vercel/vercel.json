{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    },
    "api/lumajang/scrape-chunk.ts": {
      "maxDuration": 300
    }
  }
}
